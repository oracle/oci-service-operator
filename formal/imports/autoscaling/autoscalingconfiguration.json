{
  "schemaVersion": 1,
  "surface": "provider-facts",
  "service": "autoscaling",
  "slug": "autoscalingconfiguration",
  "kind": "AutoScalingConfiguration",
  "sourceRef": "terraform-provider-oci",
  "providerResource": "oci_autoscaling_auto_scaling_configuration",
  "operations": {
    "create": [
      {
        "operation": "CreateAutoScalingConfiguration",
        "requestType": "autoscaling.CreateAutoScalingConfigurationRequest",
        "responseType": "autoscaling.CreateAutoScalingConfigurationResponse"
      }
    ],
    "get": [
      {
        "operation": "GetAutoScalingConfiguration",
        "requestType": "autoscaling.GetAutoScalingConfigurationRequest",
        "responseType": "autoscaling.GetAutoScalingConfigurationResponse"
      }
    ],
    "list": [
      {
        "operation": "ListAutoScalingConfigurations",
        "requestType": "autoscaling.ListAutoScalingConfigurationsRequest",
        "responseType": "autoscaling.ListAutoScalingConfigurationsResponse"
      }
    ],
    "update": [
      {
        "operation": "ChangeAutoScalingConfigurationCompartment",
        "requestType": "autoscaling.ChangeAutoScalingConfigurationCompartmentRequest",
        "responseType": "autoscaling.ChangeAutoScalingConfigurationCompartmentResponse"
      },
      {
        "operation": "UpdateAutoScalingConfiguration",
        "requestType": "autoscaling.UpdateAutoScalingConfigurationRequest",
        "responseType": "autoscaling.UpdateAutoScalingConfigurationResponse"
      }
    ],
    "delete": [
      {
