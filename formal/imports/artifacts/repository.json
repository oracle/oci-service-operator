    ],
    "conflictsWith": {}
  },
  "hooks": {
    "create": [
      {
        "helper": "tfresource.CreateResource"
      }
    ],
    "update": [
      {
        "helper": "tfresource.UpdateResource"
      },
      {
        "helper": "tfresource.WaitForUpdatedState"
      }
    ],
    "delete": [
      {
        "helper": "tfresource.DeleteResource"
      }
    ]
  },
  "deleteConfirmation": {
    "pending": [
      "DELETING"
    ],
    "target": [
      "DELETED"
    ]
  },
  "listLookup": {
    "datasource": "oci_artifacts_repositories",
    "collectionField": "repository_collection",
    "responseItemsField": "Items",
    "filterFields": [
      "compartment_id",
      "display_name",
      "id",
      "is_immutable",
      "state"
    ]
  },
  "boundary": {
    "providerFactsOnly": true,
    "repoAuthoredSpecPath": "controllers/artifacts/repository/spec.cfg",
    "repoAuthoredLogicGapsPath": "controllers/artifacts/repository/logic-gaps.md",
    "excludedSemantics": [
      "bind-versus-create",
      "secret-output",
      "delete-confirmation"
    ]
  },
  "notes": [
    "Refreshed from the pinned terraform-provider-oci Artifacts Repository resource; polymorphic runtime and deletion safeguards remain repo-authored."
  ]
