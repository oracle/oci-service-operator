{
  "schemaVersion": 1,
  "surface": "provider-facts",
  "service": "artifacts",
  "slug": "repository",
  "kind": "Repository",
  "sourceRef": "terraform-provider-oci",
  "providerResource": "oci_artifacts_repository",
  "operations": {
    "create": [
      {
        "operation": "CreateRepository",
        "requestType": "artifacts.CreateRepositoryRequest",
        "responseType": "artifacts.CreateRepositoryResponse"
      }
    ],
    "get": [
      {
        "operation": "GetRepository",
        "requestType": "artifacts.GetRepositoryRequest",
        "responseType": "artifacts.GetRepositoryResponse"
      }
    ],
    "list": [
      {
        "operation": "ListRepositories",
        "requestType": "artifacts.ListRepositoriesRequest",
        "responseType": "artifacts.ListRepositoriesResponse"
      }
    ],
    "update": [
      {
        "operation": "ChangeRepositoryCompartment",
        "requestType": "artifacts.ChangeRepositoryCompartmentRequest",
        "responseType": "artifacts.ChangeRepositoryCompartmentResponse"
      },
      {
        "operation": "UpdateRepository",
        "requestType": "artifacts.UpdateRepositoryRequest",
        "responseType": "artifacts.UpdateRepositoryResponse"
      }
    ],
    "delete": [
      {
        "operation": "DeleteRepository",
        "requestType": "artifacts.DeleteRepositoryRequest",
        "responseType": "artifacts.DeleteRepositoryResponse"
      }
    ]
