      "target": [
        "AVAILABLE"
      ]
    },
    "update": {}
  },
  "mutation": {
    "mutable": [
      "compartment_id",
      "defined_tags",
      "description",
      "display_name",
      "freeform_tags",
      "repository_type"
    ],
    "forceNew": [
