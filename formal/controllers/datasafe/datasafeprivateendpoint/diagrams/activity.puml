endif
}
if ("Delete requested?") then (yes)
partition "Delete" {
:Delete path uses DeleteDataSafePrivateEndpoint\nwith required via GetDataSafePrivateEndpoint\nor ListDataSafePrivateEndpoints to DELETED\nconfirmation;
