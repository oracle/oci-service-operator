@startuml
skinparam shadowing false
skinparam backgroundColor #fcfcfd
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam arrowColor #0f172a
skinparam noteBackgroundColor #fff7d6
skinparam noteBorderColor #b45309
skinparam noteFontColor #334155
skinparam roundcorner 16
title Activity - artifacts/ContainerRepository
skinparam activity {
  backgroundColor #f8fafc
  borderColor #0f172a
  fontColor #0f172a
  diamondBackgroundColor #e2e8f0
  diamondBorderColor #1d4ed8
  diamondFontColor #0f172a
  startColor #1d4ed8
  endColor #0f172a
  barColor #1d4ed8
}
start
partition "Observe and Bind" {
:Start from shared flow\nshared/diagrams/shared-reconcile-activity.svg;
:Read desired ContainerRepository spec, tracked\nstatus, and delete intent;
if ("Tracked or explicit OCI identity present?") then (yes)
:Get the current OCI resource via\nGetContainerRepository;
else (no)
:Resolve an existing OCI resource through\nListContainerRepositories using filters\ncompartmentId, displayName, id;
:Create the OCI resource via\nCreateContainerRepository when no reusable\nmatch is found;
:Persist the resolved or created OCI identity\ninto status;
endif
}
if ("Delete requested?") then (yes)
partition "Delete" {
:Delete path uses DeleteContainerRepository\nwith required via GetContainerRepository or\nListContainerRepositories to DELETED\nconfirmation;
:Confirm deletion via GetContainerRepository or\nListContainerRepositories until OCI reaches\nDELETED;
if ("Delete cleanup and finalizer release succeed?") then (yes)
:Remove the finalizer after delete completion;
else (no)
:Stay blocked until cleanup or finalizer\nrelease succeeds;
endif
}
stop
else (no)
partition "Lifecycle Classification" {
if ("OCI state in retryable set?") then (yes)
:Request requeue while OCI remains in DELETING;
stop
endif
if ("OCI state is outside success targets?") then (yes)
:Return an unsuccessful reconcile result until\nOCI reaches AVAILABLE;
stop
endif
}
partition "Ready and Drift Handling" {
:Compare live OCI state against the\nrepo-authored mutation surface;
if ("Force-new or conflicting drift detected?") then (yes)
:Reject drift before OCI mutation for force-new\nfields compartmentId, displayName;
stop
endif
if ("Supported mutable drift detected?") then (yes)
:Apply ChangeContainerRepositoryCompartment,\nUpdateContainerRepository only for mutable\nfields isImmutable, isPublic, readme,\nfreeformTags (+1 more);
else (no)
:Skip the no-op mutation path;
endif
:Run provider helper hooks\ncreate=tfresource.CreateResource;\nupdate=tfresource.UpdateResource,\ntfresource.WaitForUpdatedState;\ndelete=tfresource.DeleteResource when the\nmatching field-driven path executes;
:Apply explicit follow-up semantics\ncreate=read-after-write;\nupdate=read-after-write; delete=confirm-delete;
:Return success for the AVAILABLE success state;
:Project required status and finalizer policy\nretain-until-confirmed-delete;
:Requeue on terminating;
}
endif
stop
note right
shared diagram:
shared/diagrams/shared-reconcile-activity.svg
Start from the shared reconcile activity and
specialize provider-backed CRUD, wait, and
status-projection details here.
Controller-local activity diagrams add
list-lookup hints, secret policies, delete
handling, and open formal gaps.
archetype batch: Generated service-manager
controllers specialize the shared reconcile path
with formal runtime ownership.
service: artifacts
slug: containerrepository
kind: ContainerRepository
archetype: generated-service-manager
status/finalizer: required /
retain-until-confirmed-delete
requeue: terminating
provider states: create none; update none;
delete DELETING
follow-up: create=read-after-write;
update=read-after-write; delete=confirm-delete
supported drift: isImmutable, isPublic, readme,
freeformTags (+1 more)
reject before mutate: force-new fields
compartmentId, displayName
create-only fields: none
list lookup:
oci_artifacts_container_repositories filters
compartmentId, displayName, id; Adopt only a
unique repository match in the requested
compartment.
conflicts: none
open gaps: none
Create and update return AVAILABLE directly;
delete retains the finalizer through DELETING
until DELETED, REPO_ID_UNKNOWN, or scoped
absence.
Auth-shaped NotAuthorizedOrNotFound remains
ambiguous and does not release the finalizer
without stronger evidence.
Repository visibility, immutability, README, and
tags update in place; compartmentId and
displayName require replacement.
The runtime has no Kubernetes Secret side
effects.
end note
@enduml
