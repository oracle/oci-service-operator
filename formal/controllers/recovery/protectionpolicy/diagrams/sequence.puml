Kubernetes -> Controller: enqueue ProtectionPolicy reconcile
Controller -> BaseReconciler: Reconcile(request)
BaseReconciler -> ServiceManager: reconcile desired ProtectionPolicy
group Lookup and bind
alt tracked or explicit OCI identity already exists
ServiceManager -> OCI: GetProtectionPolicy
else tracked identity is missing
ServiceManager -> OCI: ListProtectionPolicies(filters:\ncompartmentId, displayName, id)
alt reusable OCI resource is not found
ServiceManager -> OCI: CreateProtectionPolicy
loop create pending CREATING
ServiceManager -> OCI: GetProtectionPolicy
end
else reusable OCI resource already exists
ServiceManager -> OCI: GetProtectionPolicy
end
ServiceManager --> BaseReconciler: persist resolved OCI identity in status
end
alt delete requested
group Delete
ServiceManager -> OCI: DeleteProtectionPolicy
ServiceManager -> OCI: confirm delete via\nGetProtectionPolicy or\nListProtectionPolicies
loop delete pending DELETE_SCHEDULED,\nDELETING
ServiceManager -> OCI: GetProtectionPolicy or\nListProtectionPolicies
end
alt cleanup or finalizer release is blocked
ServiceManager --> BaseReconciler: retain delete state and retry
else delete completion observed
ServiceManager --> BaseReconciler: release finalizer after delete completion
end
end
else OCI state is retryable
ServiceManager --> BaseReconciler: requeue while OCI remains in\nCREATING, UPDATING,\nDELETE_SCHEDULED, DELETING
else live state requires field-aware\ndrift evaluation
