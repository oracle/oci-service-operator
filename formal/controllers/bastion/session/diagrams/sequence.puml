end
ServiceManager -> OCI: run helper hooks\ncreate=tfresource.CreateResource,\ntfresource.WaitForWorkRequestWithErrorHandling\nentity=session action=CREATED;\nupdate=tfresource.UpdateResource;\ndelete=tfresource.DeleteResource,\ntfresource.WaitForWorkRequestWithErrorHandling\nentity=session action=DELETED
ServiceManager -> OCI: apply follow-up strategy\ncreate=GetWorkRequest -> GetSession;\nupdate=read-after-write;\ndelete=confirm-delete
end
