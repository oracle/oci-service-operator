@startuml
skinparam shadowing false
skinparam backgroundColor #fcfcfd
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam arrowColor #0f172a
skinparam noteBackgroundColor #fff7d6
skinparam noteBorderColor #b45309
skinparam noteFontColor #334155
skinparam roundcorner 16
title Activity - opsi/EnterpriseManagerBridge
skinparam activity {
  backgroundColor #f8fafc
  borderColor #0f172a
  fontColor #0f172a
  diamondBackgroundColor #e2e8f0
  diamondBorderColor #1d4ed8
  diamondFontColor #0f172a
  startColor #1d4ed8
  endColor #0f172a
  barColor #1d4ed8
}
start
partition "Observe and Bind" {
:Start from shared flow\nshared/diagrams/shared-reconcile-activity.svg;
:Read desired EnterpriseManagerBridge spec,\ntracked status, and delete intent;
if ("Tracked or explicit OCI identity present?") then (yes)
:Get the current OCI resource via\nGetEnterpriseManagerBridge;
else (no)
:Resolve an existing OCI resource through\nListEnterpriseManagerBridges using filters\ncompartmentId, displayName,\nobjectStorageBucketName;
:Create the OCI resource via\nCreateEnterpriseManagerBridge when no reusable\nmatch is found;
:Persist the resolved or created OCI identity\ninto status;
endif
}
if ("Delete requested?") then (yes)
partition "Delete" {
:Delete path uses DeleteEnterpriseManagerBridge\nwith required via GetEnterpriseManagerBridge\nor ListEnterpriseManagerBridges to DELETED\nconfirmation;
:Confirm deletion via\nGetEnterpriseManagerBridge or\nListEnterpriseManagerBridges until OCI reaches\nDELETED;
if ("Delete cleanup and finalizer release succeed?") then (yes)
:Remove the finalizer after delete completion;
else (no)
:Stay blocked until cleanup or finalizer\nrelease succeeds;
endif
}
stop
else (no)
partition "Lifecycle Classification" {
if ("OCI state in retryable set?") then (yes)
:Request requeue while OCI remains in CREATING,\nUPDATING, DELETING;
stop
endif
if ("OCI state is outside success targets?") then (yes)
:Return an unsuccessful reconcile result until\nOCI reaches ACTIVE, NEEDS_ATTENTION;
stop
endif
}
partition "Ready and Drift Handling" {
:Compare live OCI state against the\nrepo-authored mutation surface;
if ("Force-new or conflicting drift detected?") then (yes)
:Reject drift before OCI mutation for force-new\nfields compartmentId, objectStorageBucketName;
stop
endif
if ("Supported mutable drift detected?") then (yes)
:Apply UpdateEnterpriseManagerBridge only for\nmutable fields definedTags, description,\ndisplayName, freeformTags;
else (no)
:Skip the no-op mutation path;
endif
:Run provider helper hooks\ncreate=generatedruntime.Create\nentity=EnterpriseManagerBridge action=CREATED;\nupdate=generatedruntime.Update\nentity=EnterpriseManagerBridge action=UPDATED;\ndelete=generatedruntime.Delete\nentity=EnterpriseManagerBridge action=DELETED\nwhen the matching field-driven path executes;
:Apply explicit follow-up semantics\ncreate=read-after-write;\nupdate=read-after-write; delete=confirm-delete;
:Return success for the ACTIVE, NEEDS_ATTENTION\nsuccess state;
:Project required status and finalizer policy\nretain-until-confirmed-delete;
:Requeue on provisioning, updating, terminating;
}
endif
stop
